# Copy to .env. Never commit .env; existing shell variables take precedence.
SUSHI_URL=http://127.0.0.1:12453/v1/chat/completions
SUSHI_MODEL=heretic
SUSHI_API_KEY=
# Set your own OpenAI-compatible server URL and model.
RIG_URL=http://127.0.0.1:8010/v1/chat/completions
RIG_MODEL=your-model-name
RIG_API_KEY=
# Template control is backend-specific; verify response has no reasoning.
RIG_THINKING_MODE=template
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional server-side fallback; you can instead type the NanoGPT key in the UI.
NANOGPT_API_KEY=
# Optional trusted PEM bundle; normally certifi or macOS /etc/ssl/cert.pem is used.
# NANOGPT_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
