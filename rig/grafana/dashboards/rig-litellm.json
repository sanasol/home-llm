{
 "uid": "rig-litellm",
 "title": "LiteLLM gateway",
 "tags": [
  "rig",
  "litellm"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "links": [
  {
   "title": "Rig overview",
   "type": "link",
   "url": "/d/rig-overview",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "type": "row",
   "title": "Traffic",
   "collapsed": false,
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Req/s (5m)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "rigprom"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(litellm_proxy_total_requests_metric_total[5m]))",
     "legendFormat": "req/s",
     "datasource": {
      "type": "prometheus",
      "uid": "rigprom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto",
    "orientation": "auto"
   }
  },
  {
