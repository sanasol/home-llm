# /etc/systemd/system/hyperqwen-b.service
# Slot B = clone of A's profile (FP8 KV, MTP, 150K) on B's own 3090, now on
# vLLM 0.32 (worktree ~/HyperQwen-0.32 @ pr-387) — 2026-10-28.
# Pre-0.32 (clone, vLLM 0.31) unit: /opt/rig/snapshots/2026-10-28-hyperqwen-b/hyperqwen-b.service.pre-0.32
# Pre-clone (KVarN 262K) unit:        /opt/rig/snapshots/2026-10-28-hyperqwen-b/hyperqwen-b.service.pre-clone
[Unit]
Description=HyperQwen side slot B (clone of A: fp8 KV, MTP, 150K; vLLM 0.32) on internal 3090 :18021
After=network-online.target rig-gpu-power.service hyperqwen-a.service
Wants=rig-gpu-power.service

[Service]
TimeoutStartSec=900
Type=simple
ExecStartPre=/bin/bash -c "for i in $(seq 1 120); do curl -sf http://localhost:18020/health >/dev/null && exit 0; sleep 10; done; exit 0"
User=al
WorkingDirectory=~/HyperQwen-0.32
Environment=PORT=18021
Environment=CTX=long
Environment=SPEC=mtp
Environment=PTH_FA=0
Environment=MODEL=~/HyperQwen-0.32/models/Qwen3.8-27B-W4A16-AutoRound-fast
Environment=CUDA_VISIBLE_DEVICES=GPU-2e674bbf-af1e-4ad3-17f6-abc8e47b4f36
Environment=CUDA_HOME=~/HyperQwen-0.32/venv/lib/python3.14/site-packages/nvidia/cu13
Environment=PATH=~/HyperQwen-0.32/venv/lib/python3.14/site-packages/nvidia/cu13/bin:~/HyperQwen-0.32/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash ~/HyperQwen-0.32/single-user/start_qwen.sh
ExecStartPost=/bin/bash -c "for i in $(seq 1 60); do curl -sf http://localhost:18021/health >/dev/null && break; sleep 5; done; cd ~/HyperQwen-0.32 && PORT=18021 timeout 300 bash bench/warmup.sh || true"
Restart=on-failure
RestartSec=15
MemoryMax=40G

[Install]
WantedBy=multi-user.target
