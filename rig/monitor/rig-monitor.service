[Unit]
Description=Rig monitor (Strata lanes main + lane2 + lane3, hardware, :8090)
After=network-online.target llm-main.service llm-lane2.service llm-lane3.service

[Service]
User=al
ExecStart=/usr/bin/python3 /opt/rig/monitor/monitor.py
Restart=always
RestartSec=3
Environment=PORT=8090

[Install]
WantedBy=multi-user.target
