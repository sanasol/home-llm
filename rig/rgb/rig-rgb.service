[Unit]
Description=Rig RGB: LLM equalizer (FN mode: 5090=FN 5090, RAM=FN 3090 lanes; DS mode: every device = DeepSeek; green=decode, orange=prefill, red=nothing serving; AIO flashes on requests), 4 Hz engine poll
After=rig-rgb-server.service
Requires=rig-rgb-server.service
PartOf=rig-rgb-server.service

[Service]
User=al
WorkingDirectory=~/rgb
ExecStart=~/rgb/venv/bin/python ~/rgb/rgbshow.py 2 live
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
