[Unit]
Description=vLLM side: Qwen3.8-27B GPTQ on all RTX 3090 (:8002)
After=network-online.target tailscaled.service rig-gpu-power.service llm-main.service
Wants=network-online.target

[Service]
User=al
Environment=HOME=~
EnvironmentFile=/opt/rig/llm-side.env
# boot OOM guard (27.10.2026): strata-host anon ~55 GB; `strata launch` exits
# before the engine finishes loading, so After= does not serialize RAM use.
# Wait for main to be actually ready before side stages its own weights.
ExecStartPre=/usr/bin/bash -c 'timeout 900 bash -c "until curl -sf http://localhost:8001/health >/dev/null; do sleep 5; done" || true'
ExecStart=/opt/rig/llm-side.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
