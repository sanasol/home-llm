[Unit]
Description=rig LLM exporter: uniform tok/s, KV, cache, counters for the three Strata lanes FN 5090 / FN 3090 #1 / #2 (:9097 loopback)
After=network-online.target

[Service]
Type=simple
User=al
Group=al
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/python3 /opt/rig/bin/rig_llm_exporter.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
