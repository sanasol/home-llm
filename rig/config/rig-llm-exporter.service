[Unit]
Description=rig LLM exporter: uniform tok/s, KV, cache, counters for Strata/vLLM A/vLLM B (:9097 loopback)
After=network-online.target

[Service]
Type=simple
User=al
Group=al
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/python3 /opt/rig/bin/rig_llm_exporter.py
Environment=A_UNIT=hyperqwen-a
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
