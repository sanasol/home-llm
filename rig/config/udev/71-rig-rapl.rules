# RAPL CPU energy counters readable by node-exporter (User=prometheus) -> node_rapl_*_joules_total.
# Kernel makes energy_uj root-only (PLATYPUS side channel); single-tenant rig, so expose to the prometheus group only.
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", RUN+="/bin/chgrp prometheus /sys%p/energy_uj", RUN+="/bin/chmod 0440 /sys%p/energy_uj"
